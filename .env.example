ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://hookhaven:hookhaven@localhost:5432/hookhaven
REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Comma-separated Fernet keys (first one encrypts). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=change-me
# Dev only: allow delivering to localhost/private IPs. Refused in production.
ALLOW_PRIVATE_DESTINATIONS=false
# Delivery worker
WORKER_CONCURRENCY=10
DELIVERY_TIMEOUT_SECONDS=10
DELIVERY_LEASE_SECONDS=60
DELIVERY_MAX_ATTEMPTS=7
# Reconciler and endpoint health
RECONCILE_INTERVAL_SECONDS=30
RECONCILE_GRACE_SECONDS=120
RECONCILE_BATCH_SIZE=500
ENDPOINT_DISABLE_THRESHOLD=10
